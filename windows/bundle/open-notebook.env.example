# Open Notebook - Windows offline bundle configuration
# Copied to .env on first start. Edit .env, then restart (Stop + Start).

# Encryption key for API keys stored in the database.
# Leave empty: a random key is generated on first start. BACK UP .env afterwards.
OPEN_NOTEBOOK_ENCRYPTION_KEY=

# Optional password for the web UI (recommended if FRONTEND_HOST=0.0.0.0)
# OPEN_NOTEBOOK_PASSWORD=

# --- Network -----------------------------------------------------------------
# 127.0.0.1 = only this PC. 0.0.0.0 = other PCs on the network can connect
# (then also set API_HOST=0.0.0.0 and open ports 8502 + 5055 in Windows Firewall).
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8502
API_HOST=127.0.0.1
API_PORT=5055
# When serving other PCs, set the address browsers use to reach the API, e.g.:
# API_URL=http://my-server:5055

# --- Internal certificate authority -----------------------------------------
# true = trust certificates from the Windows certificate store (internal CA).
OPEN_NOTEBOOK_USE_SYSTEM_CERTS=true
# Alternative: path to a CA file (.crt/.pem)
# ESPERANTO_SSL_CA_BUNDLE=C:\certs\internal-ca.crt

# --- Offline behaviour --------------------------------------------------------
OPEN_NOTEBOOK_DISABLE_VERSION_CHECK=true

# Parallel background jobs (lower = gentler on your model server)
OPEN_NOTEBOOK_WORKER_MAX_TASKS=2

# --- Database (local, no need to change) -------------------------------------
SURREAL_USER=root
SURREAL_PASSWORD=root
SURREAL_NAMESPACE=open_notebook
SURREAL_DATABASE=open_notebook

# Models are configured in the UI: Settings -> Models -> add an
# "OpenAI Compatible" credential with your base URL (ending in /v1) and API key.
